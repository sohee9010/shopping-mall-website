# 이 파일을 복사해 .env 를 만들고 값을 채운다 (.env 는 git에 올리지 않는다)
#   cp .env.example .env
#
# VITE_ 로 시작하는 값은 빌드 시 브라우저 코드에 포함되어 누구나 볼 수 있다.
# 브라우저에 공개되어도 되는 키만 여기에 둔다.
# (Toss secret key, Supabase service_role key 같은 비밀 키는 절대 넣지 않는다)

# Supabase 대시보드 > Project Settings > API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# 토스페이먼츠 개발자센터 > API 키 > 클라이언트 키 (테스트 키는 test_ck_ 로 시작)
VITE_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxx
